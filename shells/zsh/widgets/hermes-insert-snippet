#autoload
emulate -L zsh
local -a choices out
choices=("${(f)$(command hermes --mode=snippet-list)}")
local options=$choices[1]
shift choices
(( ${#choices} )) || return 0
local selected
selected=$(printf '%s\n' "${choices[@]}" | ${HERMES_FZF_COMMAND:-fzf} ${(z)options}) || return 0
selected=${selected%%:*}
out=("${(f)$(command hermes --mode=insert-snippet --input.snippet="$selected" --input.lbuffer="$LBUFFER" --input.rbuffer="$RBUFFER")}")
if [[ $out[1] == success ]]; then
  BUFFER=$out[2]
  CURSOR=$out[3]
fi
zle reset-prompt
